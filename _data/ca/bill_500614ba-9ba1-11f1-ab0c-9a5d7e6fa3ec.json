{"legislative_session": "20252026", "identifier": "SB328", "title": "Hazardous waste generation and handling fees: study and report: affordable housing development projects.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": ["Hazardouswastegenerationandhandlingfees", "affordablehousingdevelopmentprojects", "studyandreport"], "abstracts": [{"note": "summary", "abstract": "The hazardous waste control laws require a generator of hazardous waste to pay to the California Department of Tax and Fee Administration a generation and handling fee for each generator site that generates an amount equal to, or more than, 5 tons of hazardous waste for each calendar year, or portion of the calendar year, as provided. Existing law requires the Department of Toxic Substances Control, by March 1, 2023, and every 3 years thereafter, to prepare and post on its internet website a report that includes an analysis of available data related to hazardous waste, including specified components regarding hazardous waste streams, facilities, transportation, fees, and identification criteria, as provided.\n\nThis bill would require the Department of Toxic Substances Control to prepare and submit to the Legislature, no later than December 31, 2029, a report regarding the generation and handling fee imposed on affordable housing development projects. The bill would require the report to include specified information on hazardous waste generation, project locations and types, and fees assessed. The bill would authorize the department to consider specified criteria, including trends, barriers, and other relevant data in preparing the report. The bill would require the report, to the extent feasible, to cover data for at least 5 years. The bill would authorize inclusion of information from the report in the department's existing periodic hazardous waste report."}], "other_titles": [{"note": "", "title": "Hazardous waste generation and handling fees: Department of Toxic Substances Control oversight responses: housing development projects."}, {"note": "", "title": "Hazardous waste generation and handling fees: Department of Toxic Substances Control oversight and postentitlement phase permit responses: housing development projects."}, {"note": "", "title": "Hazardous waste generator permits: housing development projects."}, {"note": "", "title": "Hazardous waste control: investigations."}, {"note": "", "title": "Hazardous waste generation and handling fees: Department of Toxic Substances Control oversight and postentitlement phase permit responses: housing development, park, or open-space projects and nonprofit entity requests."}], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-sb328"}], "actions": [{"description": "Introduced. Read first time. To Com. on RLS. for assignment. To print.", "date": "2025-02-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "reading-1", "referral-committee"], "related_entities": []}, {"description": "From printer. May be acted upon on or after March 14.", "date": "2025-02-12", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}, {"description": "Referred to Com. on RLS.", "date": "2025-02-19", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on RLS.", "entity_type": "organization", "organization_id": null}]}, {"description": "From committee with author's amendments. Read second time and amended. Re-referred to Com. on RLS.", "date": "2025-03-17", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-passage", "committee-passage", "reading-1", "reading-2", "referral-committee"], "related_entities": [{"name": "Com. on RLS.", "entity_type": "organization", "organization_id": null}]}, {"description": "Re-referred to Coms. on E.Q. and REV. & TAX.", "date": "2025-03-26", "organ