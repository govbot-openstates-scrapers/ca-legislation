{"legislative_session": "20252026", "identifier": "SCR193", "title": "Relative to the Emperor Norton Tunnel.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["concurrent resolution"], "subject": ["EmperorNortonTunnel"], "abstracts": [{"note": "summary", "abstract": "This measure would designate the Yerba Buena Tunnel on State Highway Route 80, located between postmile 7.719R and 7.821R in the City and County of San Francisco, as the Emperor Norton Tunnel. The measure would also request the Department of Transportation to determine the cost of appropriate signs showing this special designation, and upon receiving donations from nonstate sources covering that cost, to erect those signs."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-scr193"}], "actions": [{"description": "Introduced. Referred to Com. on RLS.", "date": "2026-08-03", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Com. on RLS.", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Wiener", "classification": "author", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Wiener\"}", "organization_id": null}, {"name": "Stefani", "classification": "coauthor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Stefani\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "SCR193", "links": [{"url": "http://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260SCR193", "media_type": "text/html"}], "date": "", "classification": ""}, {"note": "08/03/26 - Introduced", "links": [{"url": "https://leginfo.legislature.ca.gov/faces/billPdf.xhtml?bill_id=202520260SCR193&version=20250SCR19399INT", "media_type": "application/pdf"}], "date": "2026-08-03", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "http://leginfo.legislatu