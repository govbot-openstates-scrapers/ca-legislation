{"legislative_session": "20252026", "identifier": "AB2028", "title": "Deferred deposit transactions: assessments.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Deferreddeposittransactions", "assessments"], "abstracts": [{"note": "summary", "abstract": "The California Deferred Deposit Transaction Law generally provides for the licensure and regulation by the Commissioner of Financial Protection and Innovation of a person who engages in the business of making deferred deposit transactions. The law requires each licensee to pay to the commissioner its pro rata share of all costs and expenses reasonably incurred in the administration of the law, as specified.\n\nThis bill would require an invoice or assessment notice issued by the commissioner to a licensee pursuant to the provisions described above to include the pro rata amount calculation used to determine the amount due and payable by the licensee, as specified.\n\nThis bill would incorporate additional changes to Section 23016 of the Financial Code proposed by AB 2795 to be operative only if this bill and AB 2795 are enacted and this bill is enacted last."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-ab2028"}], "actions": [{"description": "Read first time. To print.", "date": "2026-02-17", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "From printer. May be heard in committee March 20.", "date": "2026-02-18", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "Referred to Com. on B. & F.", "date": "2026-03-02", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on B. & F.", "entity_type": "organization", "organization_id": null}]}, {"description": "From committee: Do pass and re-refer to Com. on APP