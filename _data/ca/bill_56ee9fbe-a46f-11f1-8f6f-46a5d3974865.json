{"legislative_session": "20252026", "identifier": "SB750", "title": "California Housing Finance Agency: credit enhancement mechanisms study.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": ["CaliforniaHousingFinanceAgency", "creditenhancementmechanismsstudy"], "abstracts": [{"note": "summary", "abstract": "Existing law establishes the California Housing Finance Agency for the primary purpose of meeting the housing needs of persons and families of low or moderate income, and sets forth various programs administered by the agency to fulfill that purpose.\n\nThis bill would require the agency to conduct a comprehensive assessment of potential credit enhancement mechanisms designed to reduce borrowing costs for housing projects receiving state financial assistance that includes specified evaluations. The bill would require the agency to submit an interim report by January 1, 2028, and a final report by July 1, 2028, as specified."}], "other_titles": [{"note": "", "title": "California Residential Mortgage Insurance Act."}, {"note": "", "title": "California Housing Finance and Credit Act."}, {"note": "", "title": "California Housing Finance Agency: credit enhancement mechanisms study: pilot credit enhancement program."}], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-sb750"}], "actions": [{"description": "Introduced. To Com. on RLS. for assignment. To print.", "date": "2025-02-21", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": []}, {"description": "From printer. May be acted upon on or after March 24.", "date": "2025-02-24", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}, {"description": "Read first time.", "date": "2025-02-24", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "Referred to Com