{"legislative_session": "20252026", "identifier": "AJR35", "title": "Relative to Pediatric Cancer Clusters in South Orange County.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["joint resolution"], "subject": ["Environmentalinvestigations", "pediatriccancerclusters"], "abstracts": [{"note": "summary", "abstract": "This measure would petition the President and the Congress of the United States to direct specified federal agencies to, among other things, oversee targeted scientific research into the environmental co-factors and potential triggers of Ewing Sarcoma. The measure would request the Governor to direct specified state agencies to establish a scientific partnership to, among other things, enable joint access to epidemiological data. The measure would further urge specific federal agencies to make grant funding available to California academic medical institutions and state agencies, among others, to investigate chemical exposure pathways and localized cluster dynamics in south Orange County."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-ajr35"}], "actions": [{"description": "Introduced. To print.", "date": "2026-08-03", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "From printer.", "date": "2026-08-04", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "Referred to Com. on HEALTH.", "date": "2026-08-06", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on HEALTH.", "entity_type": "organization", "organization_id": null}]}], "sponsorships": [{"name": "Sanchez", "classification": "author", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Sanchez\"}", "organization_id": null}, {"name": "Davies", "classification": "author", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Davies\"}", "organization_id": null}, {"name": "Dixon", "classification": "author", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Dixon\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "AJR35", "links": [{"url": "http://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260AJR35", "media_type": "text/html"}], "date": "", "classification": ""}, {"note": "08/03/26 - Introduced", "links": [{"url": "https://leginfo.legislature.ca.gov/faces/billPdf.xhtml?bill_id=202520260AJR35&version=20250AJR3599INT", "media_type": "application/pdf"}], "date": "2026-08-03", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "http://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260AJR35", "note": ""}], "extras": {"impact_clause": null, "tags": ["fiscal committee"]}, "jurisdiction": {"id": "ocd-jurisdiction/country:us/state:ca/government", "name": "California", "classification": "state", "division_id": "ocd-division/country:us/state:ca"}, "scraped_at": "2026-08-23T07:37:40+00:00", "_id": "84e3b936-9ec5-11f1-89e1-6a04236c0a12"}