{"legislative_session": "20252026", "identifier": "SJR12", "title": "Proposed 2026\u20132031 National Outer Continental Shelf Oil and Gas Leasing Program: opposition.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["joint resolution"], "subject": ["Proposed2026\u20132031NationalOuterContinentalShelfOilandGasLeasingProgram", "opposition"], "abstracts": [{"note": "summary", "abstract": "This measure would request that the federal Bureau of Ocean Energy Management hold public hearings in California on the proposed 2026\u20132031 National Outer Continental Shelf Oil and Gas Leasing Program, prepare an environmental impact statement to accompany the program, and provide the public the opportunity to comment on a draft programmatic environmental impact statement for potential offshore oil and gas leasing in California. The measure would strongly and unequivocally oppose any new offshore drilling and declare unequivocal support for the current federal prohibition on new oil or gas drilling in federal waters offshore of the Pacific coast."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-sjr12"}], "actions": [{"description": "Introduced. Referred to Com. on RLS.", "date": "2026-01-13", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Com. on RLS.", "entity_type": "organization", "organization_id": null}]}, {"description": "Re-referred to Com. on N.R. & W.", "date": "2026-01-21", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on N.R. & W.", "entity_type": "organization", "organization_id": null}]}, {"description": "Set for hearing March 24.", "date": "2026-03-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": [], "related_entities": []}, {"description": "From committee with author's amendments. Read second ti