{"legislative_session": "20252026", "identifier": "AB2597", "title": "Claims against the state: appropriation.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill", "appropriation"], "subject": ["Claimsagainstthestate", "appropriation"], "abstracts": [{"note": "summary", "abstract": "Under existing law, if sufficient appropriations are not available for the payment of certain claims, settlements, or judgments, the Attorney General is required to report the claims, settlements, and judgments to the chairperson of either the Senate Committee on Appropriations or the Assembly Committee on Appropriations, who is then required to cause introduction of legislation appropriating the funds necessary for payment.\n\nThis bill would appropriate $7,391,650.83 from the General Fund to the Attorney General for the payment of claims, settlements, or judgments against the state arising from 8 specified actions.\n\nThis bill would declare that it is to take effect immediately as an urgency statute."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-ab2597"}], "actions": [{"description": "Read first time. To print.", "date": "2026-02-20", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "From printer. May be heard in committee March 23.", "date": "2026-02-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "Referred to Com. on APPR.", "date": "2026-03-09", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on APPR.", "entity_type": "organization", "organization_id": null}]}, {"description": "From committee chair, with author's amendments: Amend, and re-refer to Com. on APPR. Read second time and amended.", "date": "2026-06-30", "organization_id": "~{\"classification\": \"lower\"}", "classifi