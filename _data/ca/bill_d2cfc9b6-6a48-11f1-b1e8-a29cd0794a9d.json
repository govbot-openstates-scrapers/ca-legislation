{"legislative_session": "20252026", "identifier": "ACR225", "title": "Relative to the 9/11 Remembrance Flag.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["concurrent resolution"], "subject": ["9/11RemembranceFlag"], "abstracts": [{"note": "summary", "abstract": "This measure would encourage the chief administrator of each public building or facility owned by the state, a county, or a municipality to display the 9/11 Remembrance Flag on September 11 of each year and to prescribe procedures necessary for its display. The measure would declare that any public official or chief administrator of a public building or facility may accept a donation of one or more 9/11 Remembrance Flags for the purpose of display at a public building or facility owned by the state, a county, or a municipality."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-acr225"}], "actions": [{"description": "Introduced. To print.", "date": "2026-06-15", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "From printer.", "date": "2026-06-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "Blanca Rubio", "classification": "author", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Blanca Rubio\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "ACR225", "links": [{"url": "http://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260ACR225", "media_type": "text/html"}], "date": "", "classification": ""}, {"note": "06/15/26 - Introduced", "links": [{"url": "https://leginfo.legislature.ca.gov/faces/billPdf.xhtml?bill_id=202520260ACR225&version=20250ACR22599INT", "media_type": "application/pdf"}], "date": "2026-06-15", "classification": ""}], "documents": [], "citations": [], "sources": [{"url": "http://leginfo.legislatur