{"legislative_session": "20252026", "identifier": "AB2344", "title": "Animal abuse: forfeiture.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["Animalabuse", "forfeiture"], "abstracts": [{"note": "summary", "abstract": "Existing law authorizes a peace officer, humane society officer, or animal control officer to take possession of a stray or abandoned animal in specified circumstances, including when the animal is kept without proper care and attention, as specified. Existing law provides that if an animal is seized pursuant to those provisions or pursuant to a warrant, the owner is personally liable to the seizing agency for the cost of the seizure and care of the animal. Existing law deems the animal to then be abandoned by the owner under specified circumstances, including if the owner, within 14 days of notice of availability of the animal to be returned, fails to pay charges and take possession of the animal.\n\nThis bill would make those provisions apply to animals seized pursuant to any provision of California law."}], "other_titles": [{"note": "", "title": "Animal abuse: registry: internet publication."}, {"note": "", "title": "Government Code."}], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-ab2344"}], "actions": [{"description": "Read first time. To print.", "date": "2026-02-19", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "From printer. May be heard in committee March 22.", "date": "2026-02-20", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "Referred to Com. on PUB. S.", "date": "2026-03-19", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on PUB. S.", "entity_type": "organization", "organization_id": null}]}, {"description": "From committee chair, with