{"legislative_session": "20252026", "identifier": "AB2146", "title": "Coordinated Entry System: study.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["CoordinatedEntrySystem", "study"], "abstracts": [{"note": "summary", "abstract": "Existing law establishes the California Interagency Council on Homelessness (council) , which has various goals, including, among other things, to serve as a statewide facilitator, coordinator, and policy development resource on ending homelessness in California.\n\nThis bill would require the council to, by July 1, 2028, complete a comprehensive statewide study of the coordinated entry system and its role in connecting individuals and families experiencing homelessness to affordable housing, as specified. The bill would require the council, in conducting the study, to meaningfully consult with a geographically representative group of stakeholders, as described, and would require the council, by July 1, 2028, to post the report on its internet website and submit the report to the Legislature and any relevant policy committees."}], "other_titles": [{"note": "", "title": "Supportive housing: prospective tenants: barriers to access."}, {"note": "", "title": "Multifamily Housing Program: Homekey."}], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-ab2146"}], "actions": [{"description": "Read first time. To print.", "date": "2026-02-18", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "From printer. May be heard in committee March 21.", "date": "2026-02-19", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "Referred to Com. on H. & C.D.", "date": "2026-03-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on H. & C.D.", "entity_type": "organization