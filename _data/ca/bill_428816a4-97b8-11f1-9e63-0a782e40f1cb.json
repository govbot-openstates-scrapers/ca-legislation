{"legislative_session": "20252026", "identifier": "SCR193", "title": "Relative to the Emperor Norton Tunnel.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["concurrent resolution"], "subject": ["EmperorNortonTunnel"], "abstracts": [{"note": "summary", "abstract": "This measure would designate the Yerba Buena Tunnel on Interstate 80, located between postmile 7.719R and 7.821R in the City and County of San Francisco, as the Emperor Norton Tunnel. The measure would also request the Department of Transportation to determine the cost of appropriate signs showing this special designation, and upon receiving donations from nonstate sources covering that cost, to erect those signs."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-scr193"}], "actions": [{"description": "Introduced. Referred to Com. on RLS.", "date": "2026-08-03", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Com. on RLS.", "entity_type": "organization", "organization_id": null}]}, {"description": "Re-referred to Com. on TRANS.", "date": "2026-08-05", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on TRANS.", "entity_type": "organization", "organization_id": null}]}, {"description": "From committee with author's amendments. Read second time and amended. Re-referred to Com. on TRANS.", "date": "2026-08-06", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-passage", "committee-passage", "reading-1", "reading-2", "referral-committee"], "related_entities": [{"name": "Com. on TRANS.", "entity_type": "organization", "organization_id": null}]}, {"description": "From committee: Be adopted and re-refer to Com. on APPR. with recommendation: To consent calendar. (Ayes 13. Noes 0.) (August 11). Re-referred to Com. on APPR.", "date": "2026-08-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-passage", "committee-passage", "committee-passage-favorable", "passage", "referral-committee"], "related_entities": [{"name": "Com. on APPR.", "entity_type": "organization", "organization_id": null}]}, {"description": "From committee: Be ordered to second reading pursuant to Senate Rule 28.8 and ordered to consent calendar.", "date": "2026-08-13", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage", "reading-1", "reading-2"], "related_entities": []}], "sponsorships": [{"name": "Wiener", "classification": "author", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Wiener\"}", "organization_id": null}, {"name": "Stefani", "classification": "coauthor", "entity_type": "person", "primary": false, "person_id": "~{\"name\": \"Stefani\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "SCR193", "links": [{"url": "http://leginfo.legislature.ca.gov/faces/billNavClient.xhtml?bill_id=202520260SCR193", "media_type": "text/html"}], "date": "", "classification": ""}, {"note": "08/03/26 - Introduced", "links": [{"url": "https://leginfo.legislature.ca.gov/faces/billPdf.xhtml?bill_id=202520260SCR193&version=20250SCR19399INT", "media_type": "application/pdf"}], "date": "2026-08-03", "classification": ""}, {"note": "08/06/26 - Amended Senate", "links": [{"url": "https://leginfo.legislature.ca.gov/faces/billPdf.xhtml?bill_id=202520260SCR193&version=20250SCR19398AMD", "media_type": "application/pdf"}], "date": "2026-08-06", "classification": ""}], "documents": [{"note": "08/10/26- Senate Transportation", "links": [{"url": "https://leginfo.legislature.ca.gov/faces/billAnalysisClient.xhtml?bill_id=202520260SCR193&analysisId=403337&analyzingOffice=Senate+Transportation", "media_type": "application/pdf"}], "date": "2026-08-10", "classification": "analysis"}], "citations": [], "sources": [{"url": "http://leginfo.legisl