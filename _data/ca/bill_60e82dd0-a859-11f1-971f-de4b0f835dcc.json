{"legislative_session": "20252026", "identifier": "AB353", "title": "Public Utilities Commission: Inspector General.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": ["InspectorGeneral", "PublicUtilitiesCommission"], "abstracts": [{"note": "summary", "abstract": "Existing law requires the Public Utilities Commission to appoint a chief internal auditor who holds office at the pleasure of the commission. Existing law makes the chief internal auditor responsible for the oversight of the internal audit unit. Existing law requires the chief internal auditor to plan, initiate, and perform audits of key financial, management, operational, and information technology functions within the commission to improve accountability and transparency to executive and state management, and to report their findings and recommendations directly to an audit subcommittee of the commission.\n\nThis bill would instead require the Governor to appoint an Inspector General, subject to Senate confirmation, to be responsible for the oversight of the internal audit unit and would instead require the Inspector General to plan, initiate, and perform audits of key financial, management, operational, and information technology functions within the commission to improve accountability and transparency to executive and state management. The bill would also require the Inspector General to ensure, among other things, that the commission administers funds and programs in a prescribed manner, fulfills mandated requirements, develops an annual audit plan, administers an effective enterprise risk management program, and monitors reporting compliance. The bill would provide for the appointment and removal of the Inspector General, as specified. The bill would authorize the Inspector General to access and examine all records, files, documents, accounts, reports, correspondence, or other property of the commission and public utilities, and would require other entities that are regulated by the commission and participate in programs administered by the commission, upon request of the Inspector General, to provide or make available to the Inspector General for examination all relevant records, files, documents, accounts, reports, correspondence, or other property pertaining to participation in those programs, as specified. The bill would require the Inspector General to report specified information to the Governor and the Legislature, as provided."}], "other_titles": [{"note": "", "title": "Communications: broadband internet service providers: affordable home internet."}, {"note": "", "title": "Public Utilities Commission: Independent Office of Audits and Investigations."}, {"note": "", "title": "Communications: broadband internet service providers: affordable home internet service."}], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-ab353"}], "actions": [{"description": "Read first time. To print.", "date": "2025-01-30", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["reading-1"], "related_entities": []}, {"description": "From printer. May be heard in committee March 2.", "date": "2025-01-31", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "Referred to Com. on C. & C.", "date": "2025-03-24", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on C. & C.", "entity_type": "organization", "organization_id": null}]}, {"description": "From committee chair, with author's amendments: Amend, and re-refer to Com. on C. & C. Read second time and amended.", "date": "2025-03-24", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-introduction", "amendment-passage", "committee-passage", "reading-1", "reading-2", "referral-committee"], "related_entities": []}, {"description": "Re-referred to Com. on C. & C.", "date": "