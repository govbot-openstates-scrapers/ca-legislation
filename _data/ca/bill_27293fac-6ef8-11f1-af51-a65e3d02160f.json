{"legislative_session": "20252026", "identifier": "ACR225", "title": "Relative to the 9/11 Remembrance Flag.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["concurrent resolution"], "subject": ["9/11RemembranceFlag"], "abstracts": [{"note": "summary", "abstract": "This measure would encourage the chief administrator of each public building or facility owned by the state, a county, or a municipality to display the 9/11 Remembrance Flag on September 11 of each year and to prescribe procedures necessary for its display. The measure would declare that any public official or chief administrator of a public building or facility may accept a donation of one or more 9/11 Remembrance Flags for the purpose of display at a public building or facility owned by the state, a county, or a municipality."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-ca-20252026-acr225"}], "actions": [{"description": "Introduced. To print.", "date": "2026-06-15", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "From printer.", "date": "2026-06-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}, {"description": "Referred to Com. on RLS.", "date": "2026-06-22", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["referral-committee"], "related_entities": [{"name": "Com. on RLS.", "entity_type": "organization", "organization_id": null}]}, {"description": "From committee: Be adopted. Ordered to Third Reading. (Ayes 8. Noes 0.) (June 22).", "date": "2026-06-22", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage", "committee-passage-favorable", "reading-1"], "related_entities": []}], "sponsorships": [{"name": "Blanca Rubio", "classification": "author", "entity_type": "person", "primary": true, "person_id": "~{\"name\": \"Blanca Rubio\"}", "organizatio